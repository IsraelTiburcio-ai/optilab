# Configuración WEB pública de Firebase. No usar service accounts ni claves privadas.
# Completar localmente con la key web de la Repository Variable o de Firebase Console > OptiLab Web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=optilab-cd829.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=optilab-cd829
VITE_FIREBASE_STORAGE_BUCKET=optilab-cd829.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=401863964479
VITE_FIREBASE_APP_ID=1:401863964479:web:55365cb9445f026075058a

# Solo desarrollo con un proyecto demo- y emulador local; nunca en producción.
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099

# Sync #4: npm run emulators:sync + npm run dev:sync supplies ALL synthetic
# demo-optilab-sync values; do not combine the real project above with these flags.
# Production is blocked even if these flags are accidentally supplied to a build.
# VITE_PROGRESS_SYNC=emulator
# VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# Panel #5: npm run dev:academic-ui supplies the same synthetic environment.
# VITE_ACADEMIC_ADMIN=emulator

# API académico. VITE_ACADEMIC_API_URL sola NO activa nada; el modo es obligatorio.
# Desarrollo: emulator + http://127.0.0.1:5200 (lo fijan scripts/teacher-env.mjs).
# Preview/producción: usar un origen HTTPS exacto en VITE_ACADEMIC_APP_ORIGIN.
# VITE_ACADEMIC_API_MODE=off
# VITE_ACADEMIC_API_URL=
# VITE_ACADEMIC_APP_ORIGIN=
