{
  "name": "optilab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "playwright test",
    "test:auth": "playwright test --config playwright.auth.config.ts",
    "test:firestore": "node scripts/test-firestore.mjs",
    "test:firestore:rules": "node --test --test-reporter=spec --test-concurrency=1 tests/firestore/*.test.mjs",
    "test:sync": "node scripts/test-sync.mjs",
    "test:sync:core": "node --import tsx --test --test-reporter=spec --test-concurrency=1 tests/sync/*.test.ts",
    "test:sync:ui": "playwright test --config playwright.sync.config.ts",
    "test:sync:production": "node scripts/test-sync-production.mjs",
    "dev:sync": "node scripts/dev-sync.mjs",
    "emulators:sync": "node scripts/emulators-sync.mjs",
    "academic:dev": "node scripts/dev-academic.mjs",
    "academic:seed": "node scripts/seed-academic.mjs",
    "academic:client": "node scripts/academic-client.mjs",
    "test:academic": "node scripts/test-academic.mjs",
    "test:academic:api": "node --import tsx --test --test-reporter=spec --test-concurrency=1 tests/academic/*.test.ts",
    "typecheck:academic": "tsc -p tsconfig.academic.json",
    "dev:academic-ui": "node scripts/dev-academic-ui.mjs",
    "test:teacher": "node scripts/test-teacher.mjs",
    "test:teacher:ui": "playwright test --config playwright.teacher.config.ts",
    "academic:seed:panel": "node scripts/seed-academic-panel.mjs",
    "test:activities:security": "node --import tsx --test --test-reporter=spec tests/activities/*.test.ts",
    "test:activities": "playwright test --config playwright.activities.config.ts",
    "test:original-games": "playwright test --config playwright.original-games.config.ts"
  },
  "dependencies": {
    "firebase": "12.19.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@firebase/rules-unit-testing": "5.0.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "firebase-admin": "14.5.0",
    "google-auth-library": "11.3.1",
    "tsx": "4.20.6",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  },
  "overrides": {
    "@firebase/app": "0.16.2",
    "@firebase/app-compat": "0.5.18",
    "@grpc/grpc-js": "1.14.6"
  }
}
